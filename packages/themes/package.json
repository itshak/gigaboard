{
  "name": "@ultrachess/themes",
  "version": "0.0.0",
  "description": "CSS-variable-only board themes for Ultra Chess React (brown, blue, green, wood).",
  "license": "MIT",
  "author": "Yahor Barkouski",
  "homepage": "https://github.com/yahorbarkouski/ultrachess-react",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahorbarkouski/ultrachess-react.git",
    "directory": "packages/themes"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./brown": {
      "import": {
        "types": "./dist/brown.d.ts",
        "default": "./dist/brown.js"
      }
    },
    "./blue": {
      "import": {
        "types": "./dist/blue.d.ts",
        "default": "./dist/blue.js"
      }
    },
    "./green": {
      "import": {
        "types": "./dist/green.d.ts",
        "default": "./dist/green.js"
      }
    },
    "./wood": {
      "import": {
        "types": "./dist/wood.d.ts",
        "default": "./dist/wood.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  },
  "size-limit": [
    { "name": "@ultrachess/themes/brown", "path": "dist/brown.js", "limit": "1 KB", "gzip": true },
    { "name": "@ultrachess/themes/blue", "path": "dist/blue.js", "limit": "1 KB", "gzip": true },
    { "name": "@ultrachess/themes/green", "path": "dist/green.js", "limit": "1 KB", "gzip": true },
    { "name": "@ultrachess/themes/wood", "path": "dist/wood.js", "limit": "1 KB", "gzip": true }
  ]
}
