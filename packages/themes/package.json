{
  "name": "@ultrachess/themes",
  "version": "1.1.0",
  "description": "CSS-variable-only board themes for @ultrachess/react — brown, blue, green, wood. Each theme is a sub-path export (~205 B gzip) with zero runtime and zero JS cost at paint time.",
  "license": "MIT",
  "author": "Yahor Barkouski",
  "homepage": "https://github.com/yahorbarkouski/ultrachess-react",
  "bugs": {
    "url": "https://github.com/yahorbarkouski/ultrachess-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahorbarkouski/ultrachess-react.git",
    "directory": "packages/themes"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "chess",
    "chess-theme",
    "css-variables",
    "brown",
    "blue",
    "green",
    "wood",
    "ultrachess",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./brown": {
      "import": {
        "types": "./dist/brown.d.ts",
        "default": "./dist/brown.js"
      },
      "require": {
        "types": "./dist/brown.d.cts",
        "default": "./dist/brown.cjs"
      }
    },
    "./blue": {
      "import": {
        "types": "./dist/blue.d.ts",
        "default": "./dist/blue.js"
      },
      "require": {
        "types": "./dist/blue.d.cts",
        "default": "./dist/blue.cjs"
      }
    },
    "./green": {
      "import": {
        "types": "./dist/green.d.ts",
        "default": "./dist/green.js"
      },
      "require": {
        "types": "./dist/green.d.cts",
        "default": "./dist/green.cjs"
      }
    },
    "./wood": {
      "import": {
        "types": "./dist/wood.d.ts",
        "default": "./dist/wood.js"
      },
      "require": {
        "types": "./dist/wood.d.cts",
        "default": "./dist/wood.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  },
  "size-limit": [
    {
      "name": "@ultrachess/themes/brown",
      "path": "dist/brown.js",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "@ultrachess/themes/blue",
      "path": "dist/blue.js",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "@ultrachess/themes/green",
      "path": "dist/green.js",
      "limit": "1 KB",
      "gzip": true
    },
    {
      "name": "@ultrachess/themes/wood",
      "path": "dist/wood.js",
      "limit": "1 KB",
      "gzip": true
    }
  ]
}
