{
  "name": "gigaboard",
  "version": "1.3.4",
  "description": "Ultra-fast React chessboard with owned state, byte-scoped subscriptions, refs-only drag, polished default theme and pieces, sounds, arrows, premoves, and SSR static rendering.",
  "license": "MIT",
  "author": "Yahor Barkouski (forked as gigaboard)",
  "homepage": "https://github.com/itshak/gigaboard",
  "bugs": {
    "url": "https://github.com/itshak/gigaboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itshak/gigaboard.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "chess",
    "chessboard",
    "react",
    "react-chessboard",
    "gigaboard",
    "gigachess",
    "chess-engine",
    "chess-ui",
    "accessibility",
    "wai-aria",
    "ssr",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./canvas": {
      "import": {
        "types": "./dist/canvas.d.ts",
        "default": "./dist/canvas.js"
      },
      "require": {
        "types": "./dist/canvas.d.cts",
        "default": "./dist/canvas.cjs"
      }
    },
    "./pieces": {
      "import": {
        "types": "./dist/pieces.d.ts",
        "default": "./dist/pieces.js"
      },
      "require": {
        "types": "./dist/pieces.d.cts",
        "default": "./dist/pieces.cjs"
      }
    },
    "./pieces/*": {
      "import": {
        "types": "./dist/pieces/*.d.ts",
        "default": "./dist/pieces/*.js"
      },
      "require": {
        "types": "./dist/pieces/*.d.cts",
        "default": "./dist/pieces/*.cjs"
      }
    },
    "./themes": {
      "import": {
        "types": "./dist/themes.d.ts",
        "default": "./dist/themes.js"
      },
      "require": {
        "types": "./dist/themes.d.cts",
        "default": "./dist/themes.cjs"
      }
    },
    "./themes/*": {
      "import": {
        "types": "./dist/themes/*.d.ts",
        "default": "./dist/themes/*.js"
      },
      "require": {
        "types": "./dist/themes/*.d.cts",
        "default": "./dist/themes/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && mkdir -p dist/sounds && cp src/sounds/*.mp3 dist/sounds/",
    "dev": "tsup --watch",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "gigachess": "^0.4.1",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^15.11.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  },
  "size-limit": [
    {
      "name": "gigaboard (ESM)",
      "path": "dist/index.js",
      "limit": "24 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom",
        "gigachess"
      ]
    },
    {
      "name": "gigaboard/server",
      "path": "dist/server.js",
      "limit": "4 KB",
      "gzip": true,
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "gigaboard/core (ESM)",
      "path": "dist/core.js",
      "limit": "10 KB",
      "gzip": true,
      "ignore": [
        "gigachess"
      ]
    },
    {
      "name": "gigaboard/pieces/neo",
      "path": "dist/pieces/neo.js",
      "limit": "2 KB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "name": "gigaboard/themes/brown",
      "path": "dist/themes/brown.js",
      "limit": "1 KB",
      "gzip": true
    }
  ]
}
