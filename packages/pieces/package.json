{
  "name": "@ultrachess/pieces",
  "version": "1.1.0",
  "description": "Tree-shakeable SVG piece sets for Ultra Chess React (cburnett, merida, alpha, neo).",
  "license": "MIT",
  "author": "Yahor Barkouski",
  "homepage": "https://github.com/yahorbarkouski/ultrachess-react",
  "bugs": {
    "url": "https://github.com/yahorbarkouski/ultrachess-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahorbarkouski/ultrachess-react.git",
    "directory": "packages/pieces"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cburnett": {
      "import": {
        "types": "./dist/sets/cburnett.d.ts",
        "default": "./dist/sets/cburnett.js"
      },
      "require": {
        "types": "./dist/sets/cburnett.d.cts",
        "default": "./dist/sets/cburnett.cjs"
      }
    },
    "./merida": {
      "import": {
        "types": "./dist/sets/merida.d.ts",
        "default": "./dist/sets/merida.js"
      },
      "require": {
        "types": "./dist/sets/merida.d.cts",
        "default": "./dist/sets/merida.cjs"
      }
    },
    "./alpha": {
      "import": {
        "types": "./dist/sets/alpha.d.ts",
        "default": "./dist/sets/alpha.js"
      },
      "require": {
        "types": "./dist/sets/alpha.d.cts",
        "default": "./dist/sets/alpha.cjs"
      }
    },
    "./neo": {
      "import": {
        "types": "./dist/sets/neo.d.ts",
        "default": "./dist/sets/neo.js"
      },
      "require": {
        "types": "./dist/sets/neo.d.cts",
        "default": "./dist/sets/neo.cjs"
      }
    },
    "./chesscom": {
      "import": {
        "types": "./dist/sets/chesscom.d.ts",
        "default": "./dist/sets/chesscom.js"
      },
      "require": {
        "types": "./dist/sets/chesscom.d.cts",
        "default": "./dist/sets/chesscom.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  },
  "size-limit": [
    {
      "name": "@ultrachess/pieces/cburnett",
      "path": "dist/sets/cburnett.js",
      "limit": "2 KB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "name": "@ultrachess/pieces/merida",
      "path": "dist/sets/merida.js",
      "limit": "2 KB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "name": "@ultrachess/pieces/alpha",
      "path": "dist/sets/alpha.js",
      "limit": "2 KB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "name": "@ultrachess/pieces/chesscom",
      "path": "dist/sets/chesscom.js",
      "limit": "2 KB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    },
    {
      "name": "@ultrachess/pieces/neo",
      "path": "dist/sets/neo.js",
      "limit": "2 KB",
      "gzip": true,
      "ignore": [
        "react"
      ]
    }
  ]
}
