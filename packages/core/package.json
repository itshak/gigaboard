{
  "name": "@ultrachess/core",
  "version": "1.0.0",
  "description": "Framework-agnostic state machine and engine adapter for Ultra Chess React. Zero React, zero DOM.",
  "license": "MIT",
  "author": "Yahor Barkouski",
  "homepage": "https://github.com/yahorbarkouski/ultrachess-react",
  "bugs": {
    "url": "https://github.com/yahorbarkouski/ultrachess-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahorbarkouski/ultrachess-react.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "peerDependencies": {
    "ultrachess": "^1.1.4"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^3.23.2",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "ultrachess": "^1.1.4",
    "vitest": "^3.0.0"
  },
  "size-limit": [
    {
      "name": "@ultrachess/core (ESM)",
      "path": "dist/index.js",
      "limit": "6 KB",
      "gzip": true
    },
    {
      "name": "@ultrachess/core (CJS)",
      "path": "dist/index.cjs",
      "limit": "6 KB",
      "gzip": true
    }
  ]
}
