{
  "name": "@gigaboard/core",
  "version": "1.1.3",
  "description": "Framework-agnostic chess board state machine and engine adapter, backed by gigachess. Byte-level Uint8Array(64) board store with per-square subscriptions — zero React, zero DOM, usable from any UI runtime.",
  "license": "MIT",
  "author": "Yahor Barkouski (forked as gigaboard)",
  "homepage": "https://github.com/itshak/turbochessboard",
  "bugs": {
    "url": "https://github.com/itshak/turbochessboard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itshak/turbochessboard.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "chess",
    "chess-engine",
    "gigachess",
    "gigaboard",
    "state-machine",
    "framework-agnostic",
    "useSyncExternalStore",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "gigachess": "^0.4.1"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.6",
    "@vitest/coverage-v8": "^3.0.0",
    "fast-check": "^3.23.2",
    "size-limit": "^11.1.6",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  },
  "size-limit": [
    {
      "name": "@gigaboard/core (ESM)",
      "path": "dist/index.js",
      "limit": "10 KB",
      "gzip": true,
      "ignore": [
        "gigachess"
      ]
    },
    {
      "name": "@gigaboard/core (CJS)",
      "path": "dist/index.cjs",
      "limit": "10 KB",
      "gzip": true,
      "ignore": [
        "gigachess"
      ]
    }
  ]
}
