{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.mjs",
    "bench/**/*.ts",
    "bench/**/*.tsx",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.bench.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
