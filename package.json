{
  "name": "gigaboard-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Gigaboard — high-performance MIT React chessboard. 1 commit/move, WAAPI + Canvas, 120fps GPU, chessground parity without GPL.",
  "license": "MIT",
  "author": "Itshak <aistreltsov@outlook.com> (fork of Yahor Barkouski ultrachess-react)",
  "homepage": "https://github.com/itshak/gigaboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itshak/gigaboard.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:visual": "turbo run test:visual",
    "bench": "turbo run bench",
    "size": "turbo run size",
    "clean": "turbo run clean && rm -rf node_modules",
    "ci": "bun run lint && bun run typecheck && bun run build && bun run test && bun run size"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "^22.10.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
