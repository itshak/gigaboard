{
  "name": "@gigaboard/example-next-showcase",
  "version": "0.0.0",
  "private": true,
  "description": "Comprehensive Next.js 15 + Gigaboard showcase — themes, piece sets, sounds, and every configurable knob.",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "biome check app",
    "typecheck": "tsc --noEmit",
    "test": "echo \"(examples don't run unit tests)\" && exit 0",
    "clean": "rm -rf .next .turbo public/sounds",
    "copy-sounds": "node scripts/copy-sounds.mjs",
    "postinstall": "node scripts/copy-sounds.mjs"
  },
  "dependencies": {
    "@gigaboard/core": "workspace:*",
    "@gigaboard/pieces": "workspace:*",
    "@gigaboard/themes": "workspace:*",
    "gigaboard": "workspace:*",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
